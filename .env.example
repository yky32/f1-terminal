# Public site URL for canonical links, Open Graph, and sitemap (production)
# NEXT_PUBLIC_SITE_URL=https://f1-terminal.example

# Data provider: mock (offline) | api-sports (live API-Sports F1 v1)
DATA_PROVIDER=mock

# API-Sports Formula-1 v1
# Docs:  https://api-sports.io/documentation/formula-1/v1
# Base:  https://v1.formula-1.api-sports.io/
# Header: x-apisports-key
# API_SPORTS_KEY=your_key_here
#
# Free tier is limited to seasons 2022–2024; set explicitly when testing:
# API_SPORTS_SEASON=2024
#
# Cache TTL for API responses in ms (default 900000 = 15 min). Stale data up to 24h on rate limit.
# API_SPORTS_CACHE_TTL_MS=900000
#
# Optional base URL override (defaults to https://v1.formula-1.api-sports.io)
# API_SPORTS_BASE_URL=https://v1.formula-1.api-sports.io

# OpenF1 (live session telemetry — wired in a follow-up)
# OPENF1_BASE_URL=https://api.openf1.org/v1
