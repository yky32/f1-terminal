# Public site URL for canonical links, Open Graph, and sitemap (production)
# NEXT_PUBLIC_SITE_URL=https://f1-terminal.example

# Data provider: mock (offline, API-Sports-shaped payloads) | apisports (real API — stub falls back to mock)
DATA_PROVIDER=mock

# API-Sports Formula-1 v1 — https://api-sports.io/documentation/formula-1/v1
# Base URL: https://v1.formula-1.api-sports.io
# API_SPORTS_KEY=your_key_here

# OpenF1 (live session telemetry — wired in a follow-up)
# OPENF1_BASE_URL=https://api.openf1.org/v1
